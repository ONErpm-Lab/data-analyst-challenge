	measure 'Receita LY' =
			
			CALCULATE(
			    [Receita],
			    SAMEPERIODLASTYEAR('Calendar'[Date])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 03. Crescimento
		lineageTag: 2e78e28c-35b6-419c-a5e6-53db2a3e8df0

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Crescimento YoY' =
			
			DIVIDE(
			    [Receita] - [Receita LY],
			    [Receita LY],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03. Crescimento
		lineageTag: 6a4aec27-6fb4-409b-85e3-e15765bc3ea2

	measure 'Receita Mês Anterior' =
			
			CALCULATE(
			    [Receita],
			    DATEADD('Calendar'[Date], -1, MONTH)
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 03. Crescimento
		lineageTag: fe55767c-7b34-40bd-ab08-555e85cb1062

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Crescimento MoM' =
			
			DIVIDE(
			    [Receita] - [Receita Mês Anterior],
			    [Receita Mês Anterior],
